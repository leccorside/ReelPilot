# Copie para .env (docker compose lê este arquivo automaticamente).
# Em produção, troque TODOS os segredos por valores longos e aleatórios.

# Portas publicadas no Windows/VPS
WEB_PORT=3100
MAILPIT_PORT=8125

# Endereço público do site (links em e-mails, callbacks de OAuth)
APP_URL=http://localhost:3100

# PostgreSQL (container "postgres")
POSTGRES_USER=reelpilot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=reelpilot

# Armazenamento S3 (container "s3", SeaweedFS). Chave secreta com 8+ caracteres.
S3_REGION=us-east-1
S3_ACCESS_KEY=reelpilot
S3_SECRET_KEY=troque-esta-chave
S3_BUCKET=reelpilot-media

# Chave AES-256 dos tokens das redes sociais no banco: 32 bytes em base64.
# Gere com: openssl rand -base64 32. Se ela mudar, os tokens já salvos ficam ilegíveis.
ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# Login (Auth.js). Segredo que assina os tokens de sessão: gere com openssl rand -base64 32.
# Trocar o segredo desconecta todo mundo.
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Login com Google (opcional): crie um "ID do cliente OAuth" (aplicativo da Web) no Google Cloud
# com o redirecionamento autorizado <APP_URL>/api/auth/callback/google. Vazio = botão desativado.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Multiplica os limites de tentativas de login/cadastro. Use 1 em produção; 50 no desenvolvimento
# permite rodar os testes de ponta a ponta várias vezes seguidas sem bloquear o IP.
AUTH_RATE_LIMIT_SCALE=1

# Worker de vídeo (container "worker"). Vídeos feitos ao mesmo tempo por container; para mais,
# suba mais containers: docker compose up -d --scale worker=3
WORKER_CONCURRENCY=2
# Roteiro: "claude" (Claude API, pago: cada vídeo gerado faz chamadas) ou "fake" (roteiro fixo, sem custo).
# Voz e imagens continuam falsas até os passos 7 e 8.
SCRIPT_PROVIDER=fake
# Chave da Claude API (console.anthropic.com). Obrigatória com SCRIPT_PROVIDER=claude.
ANTHROPIC_API_KEY=
# Modelo que escreve (claude-opus-5-5 é mais capaz e custa o dobro), modelo que revisa as regras
# de conteúdo e esforço do modelo que escreve (low, medium, high).
CLAUDE_SCRIPT_MODEL=claude-sonnet-5-5
CLAUDE_REVIEW_MODEL=claude-haiku-5-5
CLAUDE_SCRIPT_EFFORT=medium
# Pausa em cada etapa falsa, para ver o progresso no painel. Use 0 para gerar o mais rápido possível.
FAKE_PROVIDER_DELAY_MS=2000

# Remetente dos e-mails
MAIL_FROM=ReelPilot <no-reply@localhost>

# Tag da imagem de produção
IMAGE_TAG=local
