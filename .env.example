# Copie para .env (docker compose lê este arquivo automaticamente).
# Em produção, troque TODOS os segredos por valores longos e aleatórios.

# Portas publicadas no Windows/VPS
WEB_PORT=3100
MAILPIT_PORT=8125

# Endereço público do site (links em e-mails, callbacks de OAuth)
APP_URL=http://localhost:3100

# PostgreSQL (container "postgres")
POSTGRES_USER=reelpilot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=reelpilot

# Armazenamento S3 (container "s3", SeaweedFS). Chave secreta com 8+ caracteres.
S3_REGION=us-east-1
S3_ACCESS_KEY=reelpilot
S3_SECRET_KEY=troque-esta-chave
S3_BUCKET=reelpilot-media

# Chave AES-256 dos tokens das redes sociais no banco: 32 bytes em base64.
# Gere com: openssl rand -base64 32. Se ela mudar, os tokens já salvos ficam ilegíveis.
ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# Remetente dos e-mails
MAIL_FROM=ReelPilot <no-reply@localhost>

# Tag da imagem de produção
IMAGE_TAG=local
